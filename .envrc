# Per-project Tauri signing key (run `direnv allow` once). Scopes ScratchPad's
# key to this repo so it never clobbers other Tauri apps' builds.
# Tauri reads TAURI_SIGNING_PRIVATE_KEY as the key *contents*, so cat the file.
export TAURI_SIGNING_PRIVATE_KEY="$(cat /Users/dima/.tauri/scratchpad.key)"
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
